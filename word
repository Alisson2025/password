
def verifica_senha(secreta, palpite):
    if secreta == palpite:
        return "Acesso permitido."
    else:
        return "Acesso negado."


senha_secreta = [2, 0, 2, 0]
palpite_senhas = []

for _ in range(4):
    numero = int(input("Digite o número da senha: "))
    palpite_senhas.append(numero)

print(palpite_senhas)
print(verifica_senha(senha_secreta, palpite_senhas))
